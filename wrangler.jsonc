{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sovereignty-global",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "triggers": {
    "crons": ["17 3 * * *"]
  },
  "queues": {
    "producers": [
      {
        "binding": "OPERATIONS_QUEUE",
        "queue": "sovereignty-global-operations"
      }
    ],
    "consumers": [
      {
        "queue": "sovereignty-global-operations",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "sovereignty-global-operations-dlq"
      }
    ]
  },
  "workflows": [
    {
      "name": "sovereignty-global-client-onboarding",
      "binding": "ONBOARDING_WORKFLOW",
      "class_name": "ClientOnboardingWorkflow"
    }
  ],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sovereignty-global-clients",
      "database_id": "40f8e9ca-4316-468b-bed3-b7fb6954ef2c"
    }
  ],
  "r2_buckets": [
    {
      "binding": "CLIENT_FILES",
      "bucket_name": "sovereignty-global-client-files"
    }
  ]
}
